# Скоуп @whiteoligator берём из GitHub Packages.
# Токен НЕ хранится в репозитории: локально он в ~/.npmrc пользователя
#   //npm.pkg.github.com/:_authToken=<PAT с read:packages>
# на Vercel/CI — через NODE_AUTH_TOKEN.
@whiteoligator:registry=https://npm.pkg.github.com

# rooks (зависимость drill-kit) пока не объявляет React 19 в peerDeps.
# Убрать, когда rooks обновится (тот же флаг стоит в самом drill-kit).
legacy-peer-deps=true
